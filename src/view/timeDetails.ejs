<div style="width: 100vw; padding: 20px;">
  <h1>Time Details</h1>
  <form action="/handleTimeDetails" method="POST">
    <% tripPlaces.forEach((place, index)=> { %>
      <!-- Place Section -->
      <div class="card mb-4">
        <div class="card-body d-flex align-items-center">
          <!-- Image on the left -->
          <div style="flex: 1; text-align: center;">
            <img src="<%= place.imageUrl %>" alt="<%= place %>" class="img-thumbnail"
              style="max-width: 150px; max-height: 150px;" />
          </div>

          <!-- Description on the right -->
          <div style="flex: 2; margin-left: 20px;">
            <h5>
              <%= place.place %>
            </h5>
            <textarea class="form-control" name="descriptions[]" rows="3"
              placeholder="Enter description for <%= place.description %>" required></textarea>
          </div>
        </div>

        <!-- Date and Time Selection -->
        <div class="card-footer d-flex justify-content-between align-items-center">
          <!-- Date Input -->
          <div>
            <label for="date<%= index %>" class="form-label">Date</label>
            <input type="date" class="form-control" id="date<%= index %>" name="dates[]" required />
          </div>

          <!-- Time of Day Selection -->
          <div>
            <label for="time<%= index %>" class="form-label">Time of Day</label>
            <select class="form-select" id="time<%= index %>" name="times[]" required>
              <option value="Morning">Morning</option>
              <option value="Afternoon">Afternoon</option>
              <option value="Evening">Evening</option>
            </select>
          </div>
        </div>
      </div>
      <% }) %>

        <!-- Submit Button -->
        <div class="text-center">
          <button type="submit" class="btn btn-primary">Submit</button>
        </div>
  </form>
</div>