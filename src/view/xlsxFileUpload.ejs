<div style="width: 100vw; height: 94vh; display: flex; justify-content: center; align-items: center;">
  <div style="width: 40vw;">
    <h1>Upload XLSX File</h1>
    <form action="/" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <input type="file" class="form-control" name="xlsx" accept=".xlsx" required />
      </div>
      <button type="submit" class="btn btn-primary">Upload</button>
    </form>
  </div>
</div>